{
  "name": "mlep-website",
  "version": "1.1.0",
  "type": "module",
  "description": "MLEP Research Group - Machine Learning Applied to Environmental Physics",
  "main": "web/assets/js/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:optimized": "node scripts/optimize.js && vite build",
    "preview": "vite preview",
    "serve": "python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "serve:prod": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "pytest",
    "lint": "eslint \"web/assets/js/**/*.js\"",
    "lint:fix": "eslint web/assets/js/**/*.js --fix",
    "format": "prettier --write web/assets/js/**/*.js web/assets/css/**/*.css",
    "optimize": "node scripts/optimize.js",
    "analyze": "vite-bundle-analyzer dist"
  },
  "keywords": [
    "machine-learning",
    "environmental-physics",
    "research",
    "climate",
    "ai"
  ],
  "author": "MLEP Research Group",
  "license": "MIT",
  "devDependencies": {
    "vite": "8.3.0",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "terser": "5.51.2"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "leaflet": "1.9.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
